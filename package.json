{
  "name": "cn-trademarks",
  "version": "0.1.0",
  "description": "China trademark Nice-classification dataset (类似商品和服务区分表, NCL13-2026) — 45 classes / 492 groups / 12,037 items with codes, plus PostgreSQL seeds. 中国商标尼斯分类数据(大类/类似群组/项目三层,基于尼斯分类第十三版2026文本),附 PostgreSQL 播种 SQL。",
  "keywords": [
    "china",
    "chinese",
    "trademark",
    "nice-classification",
    "classification",
    "商标",
    "尼斯分类",
    "区分表",
    "类似群组",
    "知识产权"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./data/*": "./data/*",
    "./sql/*": "./sql/*",
    "./package.json": "./package.json"
  },
  "files": [
    "data",
    "sql",
    "scripts",
    "README.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "generate:sql": "node scripts/generate-sql.ts",
    "test": "node --test tests/*.test.ts"
  }
}
