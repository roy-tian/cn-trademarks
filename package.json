{
  "name": "cn-trademarks",
  "version": "0.1.1",
  "description": "Chinese trademark Nice-classification snapshots for NCL(10-2016), NCL(11-2022), NCL(12-2025), and NCL(13-2026), with PostgreSQL seeds. 中国类似商品和服务区分表第10至13版完整快照。",
  "keywords": [
    "china",
    "chinese",
    "trademark",
    "nice-classification",
    "classification",
    "商标",
    "尼斯分类",
    "区分表",
    "类似群组",
    "知识产权"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./data/*": "./data/*",
    "./sql/*": "./sql/*",
    "./package.json": "./package.json"
  },
  "files": [
    "data",
    "sql",
    "scripts/*.ts",
    "scripts/*.py",
    "README.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "generate:sql": "node scripts/generate-sql.ts",
    "generate:snapshots": "node scripts/generate-snapshot-sql.ts",
    "test": "node --test tests/*.test.ts"
  }
}
